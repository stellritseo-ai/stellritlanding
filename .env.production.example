# ==========================================
# StellR IT — Production Environment Variables
# ==========================================
# Copy this file to .env and fill in real values.
# Set these in your Vercel and Railway dashboards.

# ── VERCEL (Main React App) ────────────────────────────────────────────────────

# URL of your deployed chat/API server (Railway deployment)
# e.g. https://stellrit-chat.up.railway.app  OR  https://api.stellrit.com
VITE_CHAT_API_URL=https://YOUR-RAILWAY-APP.up.railway.app
VITE_CHAT_SOCKET_URL=https://YOUR-RAILWAY-APP.up.railway.app

# Admin access token (change this to something strong in production!)
VITE_ADMIN_TOKEN=stellr-admin-dev-2024

# Production site URL
VITE_SITE_URL=https://stellrit.com

# ── RAILWAY (Chat Server) ─────────────────────────────────────────────────────

# MongoDB Atlas connection string
DATABASE_URL=mongodb+srv://...

# Chat server port (Railway will override with its own PORT automatically)
CHAT_SERVER_PORT=3001

# Admin token (must match VITE_ADMIN_TOKEN above)
ADMIN_SECRET_TOKEN=stellr-admin-dev-2024

# Node environment
NODE_ENV=production

# Cloudinary (for file uploads)
CLOUDINARY_CLOUD_NAME=ddlfscxrm
CLOUDINARY_API_KEY=374544111595111
CLOUDINARY_API_SECRET=YrC-QFQV3MbkjsDMLtn-lFX_sGI
